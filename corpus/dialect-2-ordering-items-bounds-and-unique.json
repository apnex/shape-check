      {
        "pointer": "",
        "keyword": "uniqueItems",
        "expected": true,
        "fit": "an array whose items are all different"
      },
      {
        "pointer": "/0",
        "keyword": "maximum",
        "expected": 9,
        "fit": "a number at most 9"
      },
      {
        "pointer": "/1",
        "keyword": "minimum",
        "expected": 0,
        "fit": "a number at least 0"
