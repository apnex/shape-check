{
  "name": "@apnex/shape-check",
  "version": "0.0.0",
  "private": true,
  "description": "Judge whether a value fits a shape declared as data.",
  "license": "MIT",
  "author": "apnex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apnex/shape-check.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./corpus": "./dist/corpus.json"
  },
  "files": [
    "dist",
    "corpus"
  ],
  "scripts": {
    "build": "tsc -p . && node tools/bundle-shape-corpus.mjs",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "docs:check": "tools/check-docs.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
